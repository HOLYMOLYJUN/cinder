{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cinder-party",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  "observability": { "enabled": true },

  // 방 하나 = Durable Object 인스턴스 하나.
  // 바인딩 이름은 routePartykitRequest 가 kebab-case 로 바꿔 URL 에 쓴다:
  //   CinderRoom  ->  /parties/cinder-room/<방이름>
  "durable_objects": {
    "bindings": [
      { "name": "CinderRoom", "class_name": "CinderRoom" },
      // 흔적은 반대다 — 모두가 같은 것을 봐야 하므로 인스턴스 하나에 전부 모은다
      { "name": "CinderMarks", "class_name": "CinderMarks" }
    ]
  },

  // new_classes 가 아니라 new_sqlite_classes 여야 한다.
  // 무료 플랜에서는 SQLite 백엔드 DO 만 쓸 수 있고,
  // 옛날 글을 따라 new_classes 로 적으면 배포가 거절된다.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CinderRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["CinderMarks"] }
  ],

  "vars": {
    // 게임이 올라간 주소를 쉼표로 적는다. 스킴과 포트까지 정확히 —
    // 여기 없는 곳에서 온 연결은 403 으로 끊는다.
    // localhost 와 127.0.0.1 은 언제나 허용되므로 개발 중에는 비워도 된다.
    // 지금 들어 있는 것 — 정식 주소(cindertower.com), www(정식으로 넘기지만
    // 넘어가기 전에 요청이 한 번 나갈 수 있어 같이 열어 둔다),
    // 그리고 버셀이 붙여 주는 주소들(운영 · 이 브랜치의 프리뷰).
    //
    // Origin 은 문자열 통째로 비교한다(originAllowed 참고). 그래서 www 와
    // 벌거벗은 주소는 서로 다른 값이고, 하나만 넣으면 다른 쪽에서 403 이 난다.
    // 프리뷰 주소는 브랜치마다 다르므로 브랜치를 새로 파면 여기도 늘려야 한다.
    "ALLOWED_ORIGINS": "https://cindertower.com,https://www.cindertower.com,https://cinder-blush.vercel.app,https://cinder-git-claude-accessibility-ch-c98e09-holymolyjuns-projects.vercel.app"
  }
}
