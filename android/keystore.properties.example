# 서명 키 — 이 파일을 keystore.properties 로 복사해서 채운다.
#
# 채운 것과 .jks 는 저장소에 **들어가지 않는다** (.gitignore 가 막는다).
# 대신 잃어버리면 곤란하므로 따로 백업해 둘 것 —
# Play 앱 서명에 가입해 두면 업로드 키는 잃어도 재발급되지만,
# 가입 전에 잃으면 그 앱은 영원히 업데이트를 못 한다.
#
# storeFile 은 android/ 기준 상대경로도 되고 절대경로도 된다.
# 저장소 안에 두면 실수로 커밋될 일이 없도록 .gitignore 가 *.jks 를 막고 있지만,
# 아예 저장소 바깥(예: C:/keys/cinder.jks)에 두는 편이 더 안전하다.

storeFile=C:/keys/cinder.jks
storePassword=
keyAlias=
keyPassword=
